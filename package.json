{
  "name": "vite-plugin-react-splash",
  "version": "1.0.10",
  "description": "A Vite plugin and React hook for easy splash screen management in React apps.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamadgarmabi/vite-plugin-react-splash.git"
  },
  "homepage": "https://github.com/mohamadgarmabi/vite-plugin-react-splash#readme",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --minify --clean --dts --treeshake --target es2020",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "deploy": "npm publish --access public",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "playground": "vite playground --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "react",
    "splash-screen",
    "loading"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "vite": ">=2.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
